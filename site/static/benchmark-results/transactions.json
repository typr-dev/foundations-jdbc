    {
      "title": "Readonly combine() vs sequential (5 queries, local)",
      "description": "5000 concurrent tasks, each running 5 queries. 10 connections.",
      "metricLabel": "ops/sec",
      "code": "// readonly + combine: 5 queries fan out across all connections\npool.readonlyTransact(conn -> conn.execute(\n    q1.combine(q2).combine(q3).combine(q4).combine(q5)\n));\n\n// readonly + sequential: 5 queries, one at a time, any connection\npool.readonlyTransact(conn -> {\n    conn.queryFirst(sql1, codec);\n    conn.queryFirst(sql2, codec);\n    // ...\n});\n\n// mutable + combine: 5 queries combined, on reserved connection\npool.transact(conn -> conn.execute(\n    q1.combine(q2).combine(q3).combine(q4).combine(q5)\n));",
      "results": [
        {"name":"readonly + combine","library":"readonly + combine","opsPerSec":2153.2,"p50us":30179,"p95us":86638,"p99us":113442,"p999us":153878,"wallTimeMs":10057},
